#!/usr/bin/env bash
# Bootstrap: stands the environment up in one non-interactive command and ends in verify.
# Fill in both steps for this repository's stack; never prompt for input.
set -euo pipefail
cd "$(dirname "$0")/.."

install_deps() {
  echo "scripts/setup: no dependencies to install"
}

run_verify() {
  for f in evals/cases/*.json; do
    node -e 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"))' "$f"
  done
  node --check evals/score
  echo "scripts/setup: verify passed"
}

install_deps
run_verify
